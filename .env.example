AGENTOBS_DB_HOST=localhost
AGENTOBS_DB_PORT=5434
AGENTOBS_DB_NAME=agent_obs_dw
AGENTOBS_DB_USER=agentobs_admin
AGENTOBS_DB_PASSWORD=agentobs_pass

# Optional: set to a Slack incoming-webhook URL (or any endpoint that
# accepts {"text": "..."}) to enable real cost/error-rate alerts.
# Unset = dry-run (alerts print to stdout instead of posting anywhere).
ALERT_WEBHOOK_URL=
ALERT_DAILY_COST_THRESHOLD_USD=1.00
ALERT_ERROR_RATE_THRESHOLD=0.15

# Only needed if you're running scripts/demo_instrumentation.py against
# real Anthropic API calls instead of its offline mock fallback.
ANTHROPIC_API_KEY=
